# Anthropic **Admin** API key (sk-ant-admin...), not a regular API key
ANTHROPIC_ADMIN_API_KEY=

# Optional: e.g. /dev/cu.usbmodem1134101. Leave empty to auto-detect.
SERIAL_PORT=

# How often frames are pushed to the dongle (cheap; keeps countdowns fresh)
POLL_SECONDS=60

# How often the Anthropic API is called. Reports lag by minutes; polling faster risks 429s.
REFRESH_SECONDS=300
